---
import config from "virtual:starlight/user-config";
import type { Props } from "@astrojs/starlight/props";

import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";

const navItems = [
  {
    label: "编程",
    children: [
      {
        group: "前端四剑客",
        items: [
          { label: "HTML", href: "/coding/html/favicon" },
          { label: "CSS", href: "/coding/css/bfc" },
          { label: "JavaScript", href: "/coding/html/attrs" },
          {
            label: "TypeScript",
            href: "/coding/typescript/basic/ts-primitive-data-types",
          },
        ],
      },
      {
        group: "前端框架",
        items: [
          { label: "Vue", href: "/coding/framework/vue/vue2-learn-prepare" },
          { label: "React", href: "/coding/framework/react/react-re-renders" },
          {
            label: "Supabase",
            href: "/coding/framework/supabase/supabase-self-hosting",
          },
        ],
      },
      {
        group: "更多",
        items: [
          {
            label: "前端工程化",
            href: "/coding/front-end-engineering/travis-ci-for-vuepress",
          },
          { label: "浏览器", href: "/coding/browser/browser-render-mechanism" },
          { label: "设计模式", href: "/coding/design-pattern/uml-basics" },
          {
            label: "计算机网络",
            href: "/coding/network/cache/network-http-cache",
          },
          {
            label: "数据结构",
            href: "/coding/data-structures/stack/stack-intro",
          },
          {
            label: "算法",
            href: "/coding/algorithm/sorting-algorithm/bubble-sort",
          },
          { label: "力扣", href: "/coding/leetcode/array/twosum" },
          // { label: '数据库', href: '/coding/database/sql' },
        ],
      },
    ],
  },
  { label: "锻炼", href: "/workout/nsca-cscs/1-身体系统的结构和功能" },
  {
    label: "营养科学",
    href: "/nutrition-science/functional-nutrients/omega-3",
  },
  // { label: '功能医学', href: '/functional-medicine/endocrine-system-and-hormones/hpa-axis-cortisol-stress-response' },
  { label: "基础乐理", href: "/music-theory/和弦" },
  { label: "菜谱", href: "/dishes/dishes-design-principle" },
  {
    label: "摄影",
    href: "/photography/iphone-photography-guide/02-iphone相机基本操作和设置",
  },
  { label: "阅读", href: "/reading/爱情这门课你可别挂科" },
  { label: "AI", href: "/ai/sse-mcp-server" },
  { label: "工具", href: "/tools/obsidian/obsidian同步方案" },
];
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  <div class="center-group sl-flex">
    {shouldRenderSearch && <Search {...Astro.props} />}
    <nav class="docs-nav sl-hidden lg:sl-flex">
      {
        navItems.map((item) =>
          "children" in item ? (
            <div class="nav-dropdown">
              <span class="nav-dropdown-trigger">
                {item.label}
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="currentColor"
                >
                  <path
                    d="M2.5 4.5L6 8L9.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                  />
                </svg>
              </span>
              <div class="nav-dropdown-menu">
                {item.children.map((group) => (
                  <div class="nav-dropdown-group">
                    <div class="nav-dropdown-group-title">{group.group}</div>
                    <div class="nav-dropdown-group-items">
                      {group.items.map((subItem) => (
                        <a href={subItem.href} class="nav-dropdown-item">
                          {subItem.label}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class="nav-link">
              {item.label}
            </a>
          )
        )
      }
    </nav>
  </div>
  <div class="sl-hidden md:sl-flex right-group">
    <div class="sl-flex social-icons">
      <SocialIcons {...Astro.props} />
    </div>
    <ThemeSelect {...Astro.props} />
    <LanguageSelect {...Astro.props} />
  </div>
</div>

<style>
  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: var(--sl-nav-height);
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    flex-shrink: 0;
  }

  .center-group {
    flex: 1;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    justify-content: flex-start;
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
    flex-shrink: 0;
  }
  .social-icons::after {
    content: "";
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  .docs-nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link,
  .nav-dropdown-trigger {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.8125rem;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    transition:
      background 0.15s,
      color 0.15s;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: inherit;
  }

  .nav-link:hover,
  .nav-dropdown-trigger:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 520px;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 1rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
    display: none;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    z-index: 100;
    padding-top: 1.25rem;
  }

  .nav-dropdown-menu::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: 0;
    right: 0;
    height: 0.5rem;
  }

  .nav-dropdown:hover .nav-dropdown-menu {
    display: grid;
  }

  .nav-dropdown-group-title {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    padding: 0 0.5rem;
  }

  .nav-dropdown-group-items {
    display: flex;
    flex-direction: column;
  }

  .nav-dropdown-item {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.8125rem;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .nav-dropdown-item:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }

  @media (max-width: 72rem) {
    .nav-dropdown-menu {
      min-width: 360px;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  function scrollSidebarToActive() {
    const sidebar = document.querySelector("nav.sidebar");
    const activeLink = sidebar?.querySelector('a[aria-current="page"]');
    if (activeLink && sidebar) {
      const sidebarContent =
        sidebar.querySelector(".sidebar-content") || sidebar;
      activeLink.scrollIntoView({ block: "center", behavior: "instant" });
    }
  }

  document.addEventListener("astro:page-load", scrollSidebarToActive);
  document.addEventListener("DOMContentLoaded", scrollSidebarToActive);
</script>
