---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import PostContent from "../../components/PostBlogs/PostContent";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug || post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { Content } = await post.render();

// Map post slugs to environment variable names
const envVarMap: Record<string, string | undefined> = {
  "post-4/16": import.meta.env.BLOG_POST250416,
  "post-5/2": import.meta.env.BLOG_POST250502,
  "post-5/7": import.meta.env.BLOG_POST250507,
  "post-5/13": import.meta.env.BLOG_POST250513,
  "post-5/19": import.meta.env.BLOG_POST250519,
  "post-5/20": import.meta.env.BLOG_POST250520,
  "post-5/21": import.meta.env.BLOG_POST250521,
  "post-5/22": import.meta.env.BLOG_POST250522,
  "post-5/25": import.meta.env.BLOG_POST250525,
  "post-5/29": import.meta.env.BLOG_POST250529,
  "post-6/4": import.meta.env.BLOG_POST250604,
  "post-7/27": import.meta.env.BLOG_POST250727,
  "post-8/1": import.meta.env.BLOG_POST250801,
  "post-8/6": import.meta.env.BLOG_POST250806,
  "post-8/24": import.meta.env.BLOG_POST250824,
  "post-9/19": import.meta.env.BLOG_POST250919,
  "post-10/26": import.meta.env.BLOG_POST251026,
};

const slug = post.data.slug || post.slug;
const blogContent = envVarMap[slug] || "";
const dateStr = post.id.slice(0, 10);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={post.data.title}
      description={`秘密基地 - ${post.data.title}`}
    />
  </head>
  <body>
    <Nav />
    <main class="blog-main">
      <article class="blog-article">
        <header class="article-header">
          <h1>{post.data.title}</h1>
          <time>{dateStr}</time>
          {
            post.data.authors && (
              <span class="author">作者: {post.data.authors}</span>
            )
          }
        </header>
        <div class="article-content">
          {blogContent && <PostContent blogPostId={blogContent} client:load />}
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    line-height: 1.6;
    color: #333;
    margin: 0;
    padding: 0;
  }

  .blog-main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eee;
  }

  .article-header h1 {
    margin: 0 0 0.5rem 0;
  }

  .article-header time,
  .article-header .author {
    color: #666;
    font-size: 0.875rem;
    margin-right: 1rem;
  }

  .article-content {
    font-size: 1.1rem;
  }

  .no-content {
    background: #f5f5f5;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
    color: #666;
  }

  .no-content code {
    background: #e0e0e0;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
  }
</style>
