---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import PostContent from "../../components/PostBlogs/PostContent";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // 按日期排序
  const sortedPosts = posts.sort((a, b) => {
    const dateA = a.data.date || new Date(a.id.slice(0, 10));
    const dateB = b.data.date || new Date(b.id.slice(0, 10));
    return dateB.getTime() - dateA.getTime();
  });

  return sortedPosts.map((post, index) => ({
    params: { slug: post.data.slug || post.slug },
    props: {
      post,
      prevPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
      nextPost: index > 0 ? sortedPosts[index - 1] : null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
  prevPost: CollectionEntry<"blog"> | null;
  nextPost: CollectionEntry<"blog"> | null;
};

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

// Map post slugs to environment variable names
const envVarMap: Record<string, string | undefined> = {
  "post-4/16": import.meta.env.BLOG_POST250416,
  "post-5/2": import.meta.env.BLOG_POST250502,
  "post-5/7": import.meta.env.BLOG_POST250507,
  "post-5/13": import.meta.env.BLOG_POST250513,
  "post-5/19": import.meta.env.BLOG_POST250519,
  "post-5/20": import.meta.env.BLOG_POST250520,
  "post-5/21": import.meta.env.BLOG_POST250521,
  "post-5/22": import.meta.env.BLOG_POST250522,
  "post-5/25": import.meta.env.BLOG_POST250525,
  "post-5/29": import.meta.env.BLOG_POST250529,
  "post-6/04": import.meta.env.BLOG_POST250604,
  "post-7/27": import.meta.env.BLOG_POST250727,
  "post-8/01": import.meta.env.BLOG_POST250801,
  "post-8/06": import.meta.env.BLOG_POST250806,
  "post-8/24": import.meta.env.BLOG_POST250824,
  "post-9/19": import.meta.env.BLOG_POST250919,
  "post-10/26": import.meta.env.BLOG_POST251026,
  "post-26/04/16": import.meta.env.BLOG_POST260416,
};

const slug = post.data.slug || post.slug;
const blogContent = envVarMap[slug] || "";
const dateStr = post.id.slice(0, 10);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={post.data.title}
      description={`秘密基地 - ${post.data.title}`}
    />
  </head>
  <body>
    <Nav />
    <main class="blog-main">
      <article class="blog-article">
        <header class="article-header">
          <h1>{post.data.title}</h1>
          <time>{dateStr}</time>
          {
            post.data.authors && (
              <span class="author">作者: {post.data.authors}</span>
            )
          }
        </header>
        <div class="article-content">
          {blogContent && <PostContent blogPostId={blogContent} client:load />}
          <Content />
        </div>
      </article>

      <nav class="pagination">
        <div class="pagination-prev">
          {
            prevPost && (
              <a href={`/blog/${prevPost.data.slug || prevPost.slug}`}>
                <span class="pagination-label">← 上一篇</span>
                <span class="pagination-title">{prevPost.data.title}</span>
              </a>
            )
          }
        </div>
        <div class="pagination-next">
          {
            nextPost && (
              <a href={`/blog/${nextPost.data.slug || nextPost.slug}`}>
                <span class="pagination-label">下一篇 →</span>
                <span class="pagination-title">{nextPost.data.title}</span>
              </a>
            )
          }
        </div>
      </nav>
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    line-height: 1.6;
    color: #333;
    margin: 0;
    padding: 0;
  }

  .blog-main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eee;
  }

  .article-header h1 {
    margin: 0 0 0.5rem 0;
  }

  .article-header time,
  .article-header .author {
    color: #666;
    font-size: 0.875rem;
    margin-right: 1rem;
  }

  .article-content {
    font-size: 1.1rem;
  }

  .no-content {
    background: #f5f5f5;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
    color: #666;
  }

  .no-content code {
    background: #e0e0e0;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
    gap: 1rem;
  }

  .pagination-prev,
  .pagination-next {
    flex: 1;
    max-width: 45%;
  }

  .pagination-next {
    text-align: right;
  }

  .pagination a {
    display: block;
    padding: 1rem;
    border-radius: 8px;
    background: #f9f9f9;
    text-decoration: none;
    color: inherit;
    transition:
      background 0.2s,
      transform 0.2s;
  }

  .pagination a:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }

  .pagination-label {
    display: block;
    font-size: 0.875rem;
    color: #666;
    margin-bottom: 0.25rem;
  }

  .pagination-title {
    display: block;
    font-weight: 500;
    color: #2e8555;
  }
</style>
