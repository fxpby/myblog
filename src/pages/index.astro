---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';

const isGitHub = import.meta.env.DEPLOY_SERVER === 'deploygithub';
const baseUrl = isGitHub ? '/myblog' : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="首页" description="邂逅大大小小陆 - 遇见是缘分，感谢你的驻足" />
  </head>
  <body>
    <header class="hero">
      <nav class="nav">
        <a href="/" class="logo">邂逅大大小小陆</a>
        <div class="nav-links">
          <a href="/coding/html/attrs">文档</a>
          <!-- <a href="/heart">魔法小陆</a> -->
          <a href="https://github.com/fxpby" target="_blank" rel="noopener">GitHub</a>
        </div>
      </nav>
      <div class="hero-content">
        <h1>邂逅大大小小陆</h1>
        <p class="tagline">遇见是缘分，感谢你的驻足</p>
        <div class="hero-buttons">
          <a href="/coding/html/attrs" class="btn btn-primary">开始阅读</a>
        </div>
      </div>
    </header>

    <main class="features">
      <section class="feature">
        <div class="feature-image">
          <img src={`${baseUrl}/img/island.svg`} alt="小岛" />
        </div>
        <div class="feature-content">
          <h3>{'{ ...探索新大陆, 🎵, 🏋️‍♀️, 🍱 }'}</h3>
          <p>
            🥕🥬，各有所爱，杂食成长，营养均衡<br />
            邂逅大大小小陆，然后驻足被吸引住！🌈
          </p>
        </div>
      </section>

      <section class="topics">
        <h2>内容分类</h2>
        <div class="topic-grid">
          <a href="/coding/html/attrs" class="topic-card">
            <span class="topic-icon">💻</span>
            <span class="topic-title">编程</span>
            <span class="topic-desc">前端、后端、算法</span>
          </a>
          <a href="/workout/nsca-cscs/17-抗阻训练的计划设计" class="topic-card">
            <span class="topic-icon">🏋️</span>
            <span class="topic-title">锻炼</span>
            <span class="topic-desc">NSCA-CSCS、训练计划</span>
          </a>
          <a href="/nutrition-science/functional-nutrients/omega-3" class="topic-card">
            <span class="topic-icon">🥗</span>
            <span class="topic-title">营养科学</span>
            <span class="topic-desc">维生素、减脂、营养素</span>
          </a>
          <a href="/music-theory/和弦" class="topic-card">
            <span class="topic-icon">🎵</span>
            <span class="topic-title">基础乐理</span>
            <span class="topic-desc">音程、和弦、七和弦</span>
          </a>
          <a href="/photography/iphone-photography-guide/02-iphone相机基本操作和设置" class="topic-card">
            <span class="topic-icon">📷</span>
            <span class="topic-title">摄影</span>
            <span class="topic-desc">iPhone摄影指南</span>
          </a>
          <a href="/ai/sse-mcp-server" class="topic-card">
            <span class="topic-icon">🤖</span>
            <span class="topic-title">AI</span>
            <span class="topic-desc">MCP、工具链、自动化</span>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
    color: #333;
  }

  .hero {
    background: linear-gradient(135deg, #2e8555 0%, #25c2a0 100%);
    color: white;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .nav .logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 1;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
  }

  .hero-content h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .tagline {
    font-size: 1.25rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: white;
    color: #2e8555;
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
  }

  .features {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .feature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 4rem;
    flex-wrap: wrap;
  }

  .feature-image img {
    width: 200px;
    height: auto;
  }

  .feature-content h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #2e8555;
  }

  .topics h2 {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 2rem;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem;
    background: #f9f9f9;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .topic-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .topic-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .topic-title {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .topic-desc {
    font-size: 0.875rem;
    color: #666;
    text-align: center;
  }

  @media (max-width: 768px) {
    .nav {
      flex-direction: column;
      gap: 1rem;
    }

    .nav-links {
      gap: 1rem;
    }

    .hero-content h1 {
      font-size: 2rem;
    }

    .feature {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
